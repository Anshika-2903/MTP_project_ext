#!/bin/bash
#PBS -N base_check
#PBS -P misn.mota2.spons
#PBS -q standard
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=01:00:00
#PBS -o base_check.out
#PBS -e base_check.err

# Sanity check: train each backbone on the RAW (uncoarsened) graph and compare
# to AH-UGC's "Base" column. If our full-graph numbers match theirs, the model
# implementations are correct. Uses matched training config (lr=0.003, 500 ep).

cd "$PBS_O_WORKDIR" || exit 1
source /apps/anaconda3/2025.06/etc/profile.d/conda.sh
conda activate fgc_comp
export LD_LIBRARY_PATH="/home/maths/mtech/mt6210961/.conda/envs/fgc_comp/lib:$LD_LIBRARY_PATH"

echo "[pbs] host=$(hostname)  job=$PBS_JOBID"
( for DS in IMDB ACM DBLP; do
    echo "===== $DS ====="
    python3 -u base_hetero.py --dataset $DS
  done ) 2>&1 | tee base_check.log
echo "[pbs] finished."
