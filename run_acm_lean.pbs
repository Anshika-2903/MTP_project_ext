#!/bin/bash
#PBS -N acm_lean
#PBS -P misn.mota2.spons
#PBS -q standard
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=04:00:00
#PBS -o acm_lean.out
#PBS -e acm_lean.err

# LEAN ACM: the 17k-author float64 coarsening is the bottleneck (~6 s/iter), so
# cut iters 200->60, obj_seeds 2->1 (ACM classes are clean; no dead-ReLU collapse
# like IMDB, so a single-seed objective is fine), max_evals->5, n_seeds->3.
# Unique filenames (acm_lean.log / hetero_acm_lean.jsonl). Runs alongside the
# slow 32976 as the primary, faster ACM path.

cd "$PBS_O_WORKDIR" || exit 1
echo "[pbs] REACHED-SCRIPT host=$(hostname) job=$PBS_JOBID start=$(date)" > acm_lean.log
source /apps/anaconda3/2025.06/etc/profile.d/conda.sh
conda activate fgc_comp
export LD_LIBRARY_PATH="/home/maths/mtech/mt6210961/.conda/envs/fgc_comp/lib:$LD_LIBRARY_PATH"
echo "[pbs] ENV-READY $(date)" >> acm_lean.log

python3 -u run_hetero_fast.py \
    --datasets ACM \
    --ratio 0.3 \
    --max_evals 5 \
    --n_seeds 3 \
    --obj_seeds 1 \
    --num_epochs 300 \
    --patience 40 \
    --iters 60 \
    --out_jsonl hetero_acm_lean.jsonl 2>&1 | tee -a acm_lean.log
echo "[pbs] finished=$(date)" >> acm_lean.log
