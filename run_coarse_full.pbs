#!/bin/bash
#PBS -N coarse_full
#PBS -P misn.mota2.spons
#PBS -q standard
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=14:00:00
#PBS -o coarse_full.out
#PBS -e coarse_full.err

# FULL overnight sweep-and-multiseed across all 3 datasets and all 3 HGCond
# backbones, at r=0.3 (AH-UGC Table 4 ratio). Uses the MULTI-BACKBONE objective
# (--objective mean): the coarsening hyperparameters are chosen to maximize the
# mean accuracy across HeteroSGC/HeteroGCN/HeteroGCN2, so a config that collapses
# 2/3 backbones (as the old SGC-only objective allowed on IMDB) can never win.
# Results append to hetero_final.jsonl and stream to coarse_full.log.

cd "$PBS_O_WORKDIR" || exit 1
source /apps/anaconda3/2025.06/etc/profile.d/conda.sh
conda activate fgc_comp
export LD_LIBRARY_PATH="/home/maths/mtech/mt6210961/.conda/envs/fgc_comp/lib:$LD_LIBRARY_PATH"

echo "[pbs] host=$(hostname)  job=$PBS_JOBID  start=$(date)"
python3 -c "import torch; print('[pbs] cuda:', torch.cuda.is_available(), torch.cuda.get_device_name(0) if torch.cuda.is_available() else '')"

python3 -u run_hetero_full.py \
    --datasets IMDB ACM DBLP \
    --ratio 0.3 \
    --max_evals 20 \
    --n_seeds 5 \
    --iters 200 \
    --objective mean 2>&1 | tee coarse_full.log
echo "[pbs] finished=$(date)"
