#!/bin/bash
#PBS -N befgc_hetero
#PBS -P misn.mota2.spons
#PBS -q standard
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=06:00:00
#PBS -o befgc_hetero_pbs.out
#PBS -e befgc_hetero_pbs.err

# Runs the full ACM+DBLP hetero pipeline (sweep + multi-seed, all 3 backbones)
# on a GPU compute node via the scheduler -- NOT on the login nodes.

cd "$PBS_O_WORKDIR" || exit 1
source /apps/anaconda3/2025.06/etc/profile.d/conda.sh
conda activate fgc_comp
# Ensure the bundled CUDA libs (libcusparse.so.11 etc.) are on the loader path.
# Use the ABSOLUTE env path -- the activate hook / $CONDA_PREFIX doesn't reliably
# populate in the batch shell.
export LD_LIBRARY_PATH="/home/maths/mtech/mt6210961/.conda/envs/fgc_comp/lib:$LD_LIBRARY_PATH"

echo "[pbs] host=$(hostname)  job=$PBS_JOBID"
echo "[pbs] LD_LIBRARY_PATH=$LD_LIBRARY_PATH"
python3 -c "import torch; print('[pbs] cuda:', torch.cuda.is_available(), torch.cuda.get_device_name(0) if torch.cuda.is_available() else '')"

python3 -u run_hetero_full.py --datasets ACM DBLP --ratio 0.3 \
        --max_evals 25 --iters 200 --n_seeds 5 --tune_model HeteroSGC \
        2>&1 | tee run_hetero_full.log

echo "[pbs] finished."
