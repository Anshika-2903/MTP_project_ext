#!/bin/bash
#PBS -N coarse_quick
#PBS -P misn.mota2.spons
#PBS -q standard
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=03:00:00
#PBS -o coarse_quick.out
#PBS -e coarse_quick.err

# Quick read of the COARSENED-graph results across all 3 datasets and all 3
# HGCond backbones, at r=0.3 (AH-UGC Table 4 ratio). Reduced sweep/seeds for a
# fast look; run the full-length version (more max_evals / n_seeds) overnight.

cd "$PBS_O_WORKDIR" || exit 1
source /apps/anaconda3/2025.06/etc/profile.d/conda.sh
conda activate fgc_comp
export LD_LIBRARY_PATH="/home/maths/mtech/mt6210961/.conda/envs/fgc_comp/lib:$LD_LIBRARY_PATH"

echo "[pbs] host=$(hostname)  job=$PBS_JOBID"
python3 -c "import torch; print('[pbs] cuda:', torch.cuda.is_available(), torch.cuda.get_device_name(0) if torch.cuda.is_available() else '')"

python3 -u run_hetero_full.py \
    --datasets IMDB ACM DBLP \
    --ratio 0.3 \
    --max_evals 8 \
    --n_seeds 2 \
    --iters 200 2>&1 | tee coarse_quick.log
echo "[pbs] finished."
