#!/bin/bash
#PBS -N acm_fast
#PBS -P misn.mota2.spons
#PBS -q standard
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=04:00:00
#PBS -o acm_fast.out
#PBS -e acm_fast.err

# Fast ACM: 10 configs, 300 epochs + early stop, 2-seed robust sweep objective.
# Unique outputs (acm_fast.log / hetero_acm_fast.jsonl).

cd "$PBS_O_WORKDIR" || exit 1
echo "[pbs] REACHED-SCRIPT host=$(hostname) job=$PBS_JOBID start=$(date)" > acm_fast.log
source /apps/anaconda3/2025.06/etc/profile.d/conda.sh
conda activate fgc_comp
export LD_LIBRARY_PATH="/home/maths/mtech/mt6210961/.conda/envs/fgc_comp/lib:$LD_LIBRARY_PATH"
echo "[pbs] ENV-READY $(date)" >> acm_fast.log

python3 -u run_hetero_fast.py \
    --datasets ACM \
    --ratio 0.3 \
    --max_evals 10 \
    --n_seeds 5 \
    --obj_seeds 2 \
    --num_epochs 300 \
    --patience 40 \
    --iters 200 \
    --out_jsonl hetero_acm_fast.jsonl 2>&1 | tee -a acm_fast.log
echo "[pbs] finished=$(date)" >> acm_fast.log
