#!/bin/bash
#PBS -N coarse_dblp
#PBS -P misn.mota2.spons
#PBS -q standard
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=13:00:00
#PBS -o coarse_dblp.out
#PBS -e coarse_dblp.err

# DBLP-only run, parallel to job 32932 (IMDB->ACM->DBLP serially) and the ACM
# job. Unique output names (coarse_dblp.log / hetero_dblp.jsonl).

cd "$PBS_O_WORKDIR" || exit 1
echo "[pbs] REACHED-SCRIPT host=$(hostname) job=$PBS_JOBID start=$(date)" > coarse_dblp.log
source /apps/anaconda3/2025.06/etc/profile.d/conda.sh
conda activate fgc_comp
export LD_LIBRARY_PATH="/home/maths/mtech/mt6210961/.conda/envs/fgc_comp/lib:$LD_LIBRARY_PATH"
echo "[pbs] ENV-READY $(date)" >> coarse_dblp.log

python3 -u run_hetero_full.py \
    --datasets DBLP \
    --ratio 0.3 \
    --max_evals 20 \
    --n_seeds 5 \
    --iters 200 \
    --objective mean \
    --out_jsonl hetero_dblp.jsonl 2>&1 | tee -a coarse_dblp.log
echo "[pbs] finished=$(date)" >> coarse_dblp.log
