#!/bin/bash
#PBS -N coarse_acm
#PBS -P misn.mota2.spons
#PBS -q standard
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=13:00:00
#PBS -o coarse_acm.out
#PBS -e coarse_acm.err

# ACM-only run, parallel to job 32932 (which is running IMDB->ACM->DBLP
# serially). Unique output names (coarse_acm.log / hetero_acm.jsonl) so there
# is zero filename collision with 32932's coarse_v3.log / hetero_v3.jsonl.

cd "$PBS_O_WORKDIR" || exit 1
echo "[pbs] REACHED-SCRIPT host=$(hostname) job=$PBS_JOBID start=$(date)" > coarse_acm.log
source /apps/anaconda3/2025.06/etc/profile.d/conda.sh
conda activate fgc_comp
export LD_LIBRARY_PATH="/home/maths/mtech/mt6210961/.conda/envs/fgc_comp/lib:$LD_LIBRARY_PATH"
echo "[pbs] ENV-READY $(date)" >> coarse_acm.log

python3 -u run_hetero_full.py \
    --datasets ACM \
    --ratio 0.3 \
    --max_evals 20 \
    --n_seeds 5 \
    --iters 200 \
    --objective mean \
    --out_jsonl hetero_acm.jsonl 2>&1 | tee -a coarse_acm.log
echo "[pbs] finished=$(date)" >> coarse_acm.log
