#!/bin/bash
#PBS -N imdb_fast2
#PBS -P misn.mota2.spons
#PBS -q standard
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=04:00:00
#PBS -o imdb_fast2.out
#PBS -e imdb_fast2.err

# Resubmit of IMDB fast with UNIQUE filenames (imdb_fast2.log /
# hetero_imdb_fast2.jsonl) so it cannot collide with the stuck job 32977 if that
# ever breaks out of its dispatch-retry loop. Seed-robust (2-seed) objective.

cd "$PBS_O_WORKDIR" || exit 1
echo "[pbs] REACHED-SCRIPT host=$(hostname) job=$PBS_JOBID start=$(date)" > imdb_fast2.log
source /apps/anaconda3/2025.06/etc/profile.d/conda.sh
conda activate fgc_comp
export LD_LIBRARY_PATH="/home/maths/mtech/mt6210961/.conda/envs/fgc_comp/lib:$LD_LIBRARY_PATH"
echo "[pbs] ENV-READY $(date)" >> imdb_fast2.log

python3 -u run_hetero_fast.py \
    --datasets IMDB \
    --ratio 0.3 \
    --max_evals 10 \
    --n_seeds 5 \
    --obj_seeds 2 \
    --num_epochs 300 \
    --patience 40 \
    --iters 200 \
    --out_jsonl hetero_imdb_fast2.jsonl 2>&1 | tee -a imdb_fast2.log
echo "[pbs] finished=$(date)" >> imdb_fast2.log
