#!/bin/bash
#PBS -N imdb_quick
#PBS -P misn.mota2.spons
#PBS -q standard
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=00:30:00
#PBS -o imdb_quick.out
#PBS -e imdb_quick.err

# Quick IMDB check with the AH-UGC-matched training config (lr=0.003, 500 ep).
cd "$PBS_O_WORKDIR" || exit 1
source /apps/anaconda3/2025.06/etc/profile.d/conda.sh
conda activate fgc_comp
export LD_LIBRARY_PATH="/home/maths/mtech/mt6210961/.conda/envs/fgc_comp/lib:$LD_LIBRARY_PATH"

echo "[pbs] host=$(hostname)  job=$PBS_JOBID"
python3 -u main_hetero.py --dataset IMDB --ratio 0.3 --iters 200 \
    --alpha 0.365 --beta 0.686 --gamma 0.0077 --eta 0.208 \
    --models HeteroSGC HeteroGCN HeteroGCN2 2>&1 | tee imdb_quick.log
echo "[pbs] finished."
