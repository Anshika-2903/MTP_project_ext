#!/bin/bash
#PBS -N heinit_all
#PBS -P misn.mota2.spons
#PBS -q standard
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=04:00:00
#PBS -o heinit_all.out
#PBS -e heinit_all.err

# He/Kaiming-initialization run across ALL THREE datasets (uniform, fair table).
# Tests whether ReLU-correct init eliminates the dead-ReLU collapse at the source
# (vs. the validation-seed-selection workaround). Lean settings so all 3 finish
# fast. Unique outputs (heinit_all.log / hetero_heinit.jsonl).

cd "$PBS_O_WORKDIR" || exit 1
echo "[pbs] REACHED-SCRIPT host=$(hostname) job=$PBS_JOBID start=$(date)" > heinit_all.log
source /apps/anaconda3/2025.06/etc/profile.d/conda.sh
conda activate fgc_comp
export LD_LIBRARY_PATH="/home/maths/mtech/mt6210961/.conda/envs/fgc_comp/lib:$LD_LIBRARY_PATH"
echo "[pbs] ENV-READY $(date)" >> heinit_all.log

python3 -u run_hetero_fast.py \
    --datasets IMDB ACM DBLP \
    --ratio 0.3 \
    --max_evals 5 \
    --n_seeds 5 \
    --obj_seeds 1 \
    --num_epochs 300 \
    --patience 40 \
    --iters 60 \
    --he_init \
    --out_jsonl hetero_heinit.jsonl 2>&1 | tee -a heinit_all.log
echo "[pbs] finished=$(date)" >> heinit_all.log
